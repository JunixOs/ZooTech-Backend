<#

string connectionString =
    @"Server=.;
      Database=ZooTech;
      Trusted_Connection=True;
      TrustServerCertificate=True;";

var settingGroups =
    new Dictionary<string,List<SettingItem>>();

var features =
    new List<string>();

var rules =
    new List<string>();

using(var connection =
    new SqlConnection(connectionString))
{
    connection.Open();

    //------------------------------------------------------
    // SETTINGS
    //------------------------------------------------------

    string settingsSql = @"
        SELECT
            sg.code       AS GroupCode,
            sd.code       AS SettingCode,
            sd.data_type  AS DataType
        FROM setting_groups sg
        INNER JOIN setting_definitions sd
            ON sd.setting_group_id = sg.id
        WHERE
            sg.is_active = 1
            AND sd.is_active = 1
            AND sg.deleted_at IS NULL
            AND sd.deleted_at IS NULL
        ORDER BY
            sg.code,
            sd.code";

    using(var cmd =
        new SqlCommand(settingsSql,connection))
    using(var reader =
        cmd.ExecuteReader())
    {
        while(reader.Read())
        {
            string groupCode =
                reader["GroupCode"].ToString();

            if(!settingGroups.ContainsKey(groupCode))
            {
                settingGroups[groupCode] =
                    new List<SettingItem>();
            }

            settingGroups[groupCode]
                .Add(new SettingItem
                {
                    Code =
                        reader["SettingCode"]
                            .ToString(),

                    DataType =
                        reader["DataType"]
                            .ToString()
                });
        }
    }

    //------------------------------------------------------
    // FEATURES
    //------------------------------------------------------

    string featureSql = @"
        SELECT code
        FROM features
        WHERE
            is_active = 1
            AND deleted_at IS NULL
        ORDER BY code";

    using(var cmd =
        new SqlCommand(featureSql,connection))
    using(var reader =
        cmd.ExecuteReader())
    {
        while(reader.Read())
        {
            features.Add(
                reader["code"].ToString());
        }
    }

    //------------------------------------------------------
    // RULES
    //------------------------------------------------------

    string ruleSql = @"
        SELECT code
        FROM rule_definitions
        WHERE
            is_active = 1
            AND deleted_at IS NULL
        ORDER BY code";

    using(var cmd =
        new SqlCommand(ruleSql,connection))
    using(var reader =
        cmd.ExecuteReader())
    {
        while(reader.Read())
        {
            rules.Add(
                reader["code"].ToString());
        }
    }
}

foreach(var group in settingGroups)
{
    string className =
        ToPascalCase(group.Key);

